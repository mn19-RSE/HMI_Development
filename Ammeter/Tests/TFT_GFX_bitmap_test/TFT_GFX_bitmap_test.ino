void setup() {
  pinMode(2, INPUT_PULLUP);
  tft.initR(INITR_144GREENTAB);  // Init ST7735R chip, green tab
  tft.setRotation(0);
  tft.fillScreen(ST77XX_BLACK);
  tft.drawRGBBitmap(0, 0, myImage, 128, 128);
}

void loop() {
  if (digitalRead(2) == LOW) {
    tft.fillScreen(ST77XX_BLACK);
    delay(500);
    tft.drawRGBBitmap(0, 0, myImage, 128, 128);
  }
}
