    i++;
  }
  tft.drawRGBBitmap(cupSymbolXLocations[cupNum], cupSymbolYLocations[cupNum], Cup_On, cupSymbolWidth, cupSymbolHeight);
}


void drawMeterValue(int meterNum) {
  // tft.drawRGBBitmap(meterXLocation, meterYLocation, meterBitmaps[meterNum], meterWidth, meterHeight);
  meterNum = constrain(meterNum, 0, 10);

  int newHeight = (meterNum * meterHeight) / 10;
  int oldHeight = (lastMeterValue * meterHeight) / 10;

  // First draw: clear entire meter area
  if (lastMeterValue < 0) {
    tft.fillRect(
      meterXLocation,
      meterYLocation,
      meterWidth,
      meterHeight,
      meterBGColor);
    if (newHeight > 0) {
      tft.fillRect(
        meterXLocation,
        meterYLocation + meterHeight - newHeight,
        meterWidth,
        newHeight,
        meterFillColor);
    }
    lastMeterValue = meterNum;
    return;
  }

  // Meter increasing
  if (newHeight > oldHeight) {
    tft.fillRect(
      meterXLocation,
      meterYLocation + meterHeight - newHeight,
      meterWidth,
      newHeight - oldHeight,
      meterFillColor);
  }
  // Meter decreasing
  else if (newHeight < oldHeight) {
    tft.fillRect(
      meterXLocation,
      meterYLocation + meterHeight - oldHeight,
      meterWidth,
      oldHeight - newHeight,
      meterBGColor);
  }

  lastMeterValue = meterNum;
}


void drawRangeSelection(int rangeNum) {
  Serial.println(rangeNum);
  if (rangeNum == 8) {
    autoMod = 40;
  }
  // tft.drawRGBBitmap(rangeXLocation, rangeYLocation, rangeBitmaps[rangeNum], rangeWidth, rangeHeight);
  // x position start with 12 and then increase by wdith of button plus button spacing
  tft.fillRect(leftXPos + ((indicatorWidth + xSpacing) * (prevRangeNum)), leftYPos, indicatorWidth + 40, indicatorHeight, 0x0000);
  tft.fillRect(leftXPos + ((indicatorWidth + xSpacing) * rangeNum), leftYPos, indicatorWidth + autoMod, indicatorHeight, 0x37f7); 
  autoMod = 0;
  prevRangeNum = rangeNum;
}

void drawCurrentText(float current) {
  unsigned long now = millis();
  if (now - lastTextUpdate >= textDelay) {              // Needs work, seems to lock up display sometimes
    tft.setCursor(currTxtXLocation, currTxtYLocation);  // x, y position
    tft.setTextColor(0x67f9, 0x0000);                   // text, background
    tft.setTextSize(2);
    tft.print(current, 2);
    lastTextUpdate = now;
  }
}


