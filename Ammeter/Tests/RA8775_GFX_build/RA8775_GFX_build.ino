bool lastCupButtonState = HIGH;
bool lastRangeButtonState = HIGH;
unsigned long lastCupPressTime = 0;
unsigned long lastRangePressTime = 0;
unsigned long lastMoveTime = 0;
unsigned long lastTextUpdate = 0;
const unsigned long debounceDelay = 250;
const unsigned long meterDelay = 100;
const unsigned long textDelay = 100;
const int NUM_CUPS = sizeof(cupTxtBitmaps) / sizeof(cupTxtBitmaps[0]);
// const int NUM_RANGES = sizeof(rangeBitmaps) / sizeof(rangeBitmaps[0]);
const int NUM_RANGES = 9;



/////////////////////////////////////////////////
const uint16_t meterFillColor = 0x37f7;
const uint16_t meterBGColor = RA8875_BLACK;
int lastMeterValue = -1;  // force first draw
////////////////////////////////////////////
enum RxState { WAIT_SYNC,
               READ_LSB,
               READ_MSB };
RxState rxState = WAIT_SYNC;
uint8_t lsb;
uint16_t latestADCValue = 0;
float analogVoltage;

void loop() {
  analogVoltage = handleUARTReceive() * 10.0f / 4095.0f;
  int roundedVoltage = round(analogVoltage);
  // drawMeterValue(roundedVoltage);
  handleInputSelection();
  handleRangeSelection();
  // drawCurrentText(analogVoltage);
  handleMeterAnimation();
}

float handleUARTReceive() {
  // Non-blocking and self-aligning UART receive
  while (Serial1.available()) {
    uint8_t b = Serial1.read();
    switch (rxState) {
      case WAIT_SYNC:
        if (b == 0xA5) {
          rxState = READ_LSB;
        }
        break;
      case READ_LSB:
        lsb = b;
        rxState = READ_MSB;
        break;
      case READ_MSB:
        latestADCValue = lsb | (b << 8);
        rxState = WAIT_SYNC;
        break;
    }
  }
  // Debug print SLOWLY
  static unsigned long lastPrint = 0;
  if (millis() - lastPrint > 50) {
    // Serial.println(latestADCValue);
    lastPrint = millis();
  }
  return latestADCValue;
}

void handleInputSelection() {
  bool buttonState = digitalRead(cupButton);
  unsigned long now = millis();
  if (lastCupButtonState == HIGH && buttonState == LOW && (now - lastCupPressTime) >= debounceDelay) {
    drawCupText(cupEnum);
    drawCupSymbol(cupEnum);
    cupEnum = (cupEnum + 1) % NUM_CUPS;  // wrap
    lastCupPressTime = now;              // record time of valid press
  }
  lastCupButtonState = buttonState;
}

void handleMeterAnimation() {
  unsigned long now = millis();
  if (now - lastMoveTime >= meterDelay) {
    meterEnum += meterDirection;
    if (meterEnum >= 11) {
      meterEnum = 11;
      meterDirection = -1;
    } else if (meterEnum <= 0) {
      meterEnum = 0;
      meterDirection = 1;
    }
    drawMeterValue(meterEnum);
    lastMoveTime = now;
  }
}

void handleRangeSelection() {
  bool buttonState = digitalRead(rangeButton);
  unsigned long now = millis();
  if (lastRangeButtonState == HIGH && buttonState == LOW && (now - lastRangePressTime) >= debounceDelay) {
    drawRangeSelection(rangeEnum);
    rangeEnum = (rangeEnum + 1) % NUM_RANGES;  // wrap
    Serial.println(rangeEnum);
    lastRangePressTime = now;                  // record time of valid press
  }
  lastRangeButtonState = buttonState;
}

