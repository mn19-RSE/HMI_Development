    tft.fillRoundRect(numXLoc, numYLoc + longEdge - shortEdge, longEdge, shortEdge, radius, numColor);  // g
  }
  if (numberDraw == 0) {
    tft.fillRoundRect(numXLoc, numYLoc + longEdge - shortEdge, longEdge, shortEdge, radius, 0x0000);   // g
    tft.fillRoundRect(numXLoc, numYLoc, longEdge, shortEdge, radius, numColor);                                                // a
    tft.fillRoundRect(numXLoc + longEdge - shortEdge, numYLoc, shortEdge, longEdge, radius, numColor);                         // b
    tft.fillRoundRect(numXLoc + longEdge - shortEdge, numYLoc + longEdge - shortEdge, shortEdge, longEdge, radius, numColor);  // c
    tft.fillRoundRect(numXLoc, numYLoc + (longEdge * 2) - (shortEdge * 2), longEdge, shortEdge, radius, numColor);             // d
    tft.fillRoundRect(numXLoc, numYLoc + longEdge - shortEdge, shortEdge, longEdge, radius, numColor);                         // e
    tft.fillRoundRect(numXLoc, numYLoc, shortEdge, longEdge, radius, numColor);                                                // f
